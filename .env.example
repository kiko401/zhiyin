# 数据库与缓存（服务器上经 Docker 网络访问共用中间件）
DATABASE_URL=mysql+aiomysql://zhiyin:password@infra-mysql:3306/zhiyin_db
REDIS_URL=redis://infra-redis:6379/3

# 扶摇金融数据 API（个股与标的事实面）
FUYAO_API_KEY=
FUYAO_BASE_URL=https://fuyao.aicubes.cn

# 研究模型（OpenAI 兼容适配层，可替换）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
JUDGE_MODEL=deepseek-v4-pro

# iFinD MCP（市场环境与归因面；留空自动降级，不影响主链路）
IFIND_MCP_URL=
IFIND_API_KEY=

# 机制开关（线上降级与评测消融共用同一实现）
LEXICON_ENABLED=true
PROFILE_ENABLED=true
LLM_ENABLED=true
SCHEDULER_ENABLED=true
